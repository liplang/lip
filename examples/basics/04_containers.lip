# Lists preserve order and use zero-based indices. Objects have string keys.
# .name and ["name"] read object fields; missing keys are errors.
# put / concat return new containers; the inputs retain their values.
flow Containers() -> object {
    names = ["Ada", "Lin"]
    person = {name: names[0], role: "reader"}
    updated = put(person, "role", "writer")
    return {
        first: person.name,
        original_role: person["role"],
        updated: updated,
        names: concat(names, ["Sam"]),
        fields: keys(person),
        has_age: has(person, "age")
    }
}
