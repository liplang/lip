# = creates an immutable binding; a name cannot be assigned again in the same scope.
# Use a new name for a new result; = does not update a mutable variable.
flow Bindings() -> object {
    price = 12
    count = 3
    subtotal = price * count
    discount = 5
    total = subtotal - discount
    # {field: value} constructs an object. Identifier keys need no quotes.
    return {subtotal: subtotal, total: total}
}
