# String indices and slice boundaries count Unicode scalars, not UTF-8 bytes.
# slice excludes its end boundary. split retains empty segments between adjacent separators.
# str formats values; parse_number accepts only complete number text as specified.
flow TextAndNumbers() -> object {
    text = "a𐀀b"
    score = parse_number("8e-1")
    return {
        length: len(text), middle: slice(text, 1, 2),
        words: split("red,,blue", ","),
        score: score, display: "score=" + str(score),
        lexical_order: "10" < "9"
    }
}
