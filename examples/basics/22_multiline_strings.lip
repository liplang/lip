# ASCII triple quotes allow multiline text; quotes and # can appear in the body.
# Indentation and leading/trailing newlines are preserved; escapes match ordinary strings, without interpolation.
flow Main() -> object {
    html = """
<main>
  <h1 title="Welcome">Hello, LIP!</h1>
</main>
"""
    prompt = """Read "carefully".
# This is text, not a comment.
"""
    quotes = """Embedded triple quotes: \"\"\""""
    return {html: html, prompt: prompt, quotes: quotes}
}
