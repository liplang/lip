# number is finite binary64. Parentheses change precedence.
# / divides; // rounds the quotient toward negative infinity; % follows the divisor sign.
# The specification defines floating-point boundaries for // and %, independently of Go/Python.
# ** is right-associative exponentiation: 2 ** 3 ** 2 = 2 ** (3 ** 2).
# Power precedes left negation: -3 ** 2 = -9; use (-3) ** 2 = 9 to square a negative base.
# Negative exponents are allowed: 2 ** -3 = 1 / 8.
# */ is logarithm with the base on the right: 8 */ 2 = 3; 3 and 3.0 are the same number.
# */ has multiplication precedence and associates left: 8 */ 2 * 4 = (8 */ 2) * 4 = 12.
flow Arithmetic() -> object {
    return {
        sum: 2 + 3 * 4,
        grouped: (2 + 3) * 4,
        division: 7 / 2,
        quotient: -5 // 3,
        remainder: -5 % 3,
        power: 2 ** 3,
        power_chain: 2 ** 3 ** 2,
        negative_power: -3 ** 2,
        negative_base: (-3) ** 2,
        inverse_power: 2 ** -3,
        logarithm: 8 */ 2,
        logic: (3 >= 2) && !(1 == 2)
    }
}
