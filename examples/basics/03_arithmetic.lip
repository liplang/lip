# number 是有限的 binary64 数值。括号可以改变计算优先级。
# / 为除法，// 为向负无穷取整的商，% 为与除数同号的余数。
# // 与 % 的浮点边界规则由规范定义，不直接继承 Go/Python 的规则。
# ** 是幂，右结合：2 ** 3 ** 2 等于 2 ** (3 ** 2)。
# 幂先于左侧负号：-3 ** 2 = -9；负数整体求平方要写 (-3) ** 2 = 9。
# 指数可为负数：2 ** -3 = 1 / 8。
# */ 求对数，右边是底数：8 */ 2 = 3（number 的 3 与 3.0 相同）。
# */ 与乘除同级，左结合：8 */ 2 * 4 = (8 */ 2) * 4 = 12。
flow Arithmetic() -> object {
    return {
        sum: 2 + 3 * 4,
        grouped: (2 + 3) * 4,
        division: 7 / 2,
        quotient: -5 // 3,
        remainder: -5 % 3,
        power: 2 ** 3,
        power_chain: 2 ** 3 ** 2,
        negative_power: -3 ** 2,
        negative_base: (-3) ** 2,
        inverse_power: 2 ** -3,
        logarithm: 8 */ 2,
        logic: (3 >= 2) && !(1 == 2)
    }
}
