fn department(row: object) -> string { return row.department }
fn amount(row: object) -> number { return row.amount }
fn positive(row: object) -> bool { return row.amount > 0 }
fn summarize(group: object) -> object {
    return {
        department: group.key,
        count: len(group.values),
        total: list.sum(list.map(group.values, amount))
    }
}

flow Sales(rows: list) -> object {
    amounts = list.map(rows, amount)
    accepted = list.filter(rows, positive)
    groups = list.group_by(accepted, department)
    return {
        departments: list.map(groups, summarize),
        total: list.sum(amounts),
        ranked: list.sort_by(rows, amount),
        batches: list.partition(rows, 2),
        columns: list.transpose([[1, 2, 3], [4, 5, 6]]),
        merged: list.concat([1, 2], [3, 4])
    }
}
