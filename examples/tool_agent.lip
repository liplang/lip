// Prototypes 27 and 28: plan once, call independent tools, then synthesize.
require host "plan_tools"
require host "call_weather"
require host "call_search"
require host "call_database"
require host "synthesize"
flow ToolAgent(request: string) -> any {
    plan = plan_tools(request)
    weather = call_weather(plan)
    search = call_search(plan)
    database = call_database(plan)
    return synthesize(plan, weather, search, database)
}
