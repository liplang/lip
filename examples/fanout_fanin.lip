# Prototypes 6 and 7: independent consumers followed by a join.
import host "extract_title"
import host "extract_text"
import host "extract_links"
import host "combine"
flow FanoutFanin(page: any) -> any {
    title = extract_title(page)
    text = extract_text(page)
    links = extract_links(page)
    return combine(title, text, links)
}
