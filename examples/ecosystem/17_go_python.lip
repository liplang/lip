# Use the teaching Host: lipc run -host demo examples/ecosystem/17_go_python.lip
# import declares a namespace; it installs no dependencies and grants no arbitrary package access.
# The Host registers both operations with parameter/result schemas and Concurrent ReadOnly contracts.
import python "statistics" as stats
import go "crypto/sha256" as sha
flow Main() -> object {
    xs = [1, 2, 3]
    # effect constructs a request; perform executes it and records the result by CallID.
    mean = perform effect stats.mean(xs)
    # An explicit Host wrapper converts Go bytes to a hexadecimal string.
    digest = perform effect sha.Sum256(str(xs))
    return {mean: mean, digest: digest}
}
