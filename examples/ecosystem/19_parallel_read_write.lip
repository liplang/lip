# Run: lipc run -host demo -parallel 4 examples/ecosystem/19_parallel_read_write.lip
# parallel permits only Concurrent ReadOnly operations; perform Writes outside the region.
# Recommended structure: parallel computation -> complete read -> sequential writes.
import go "strings" as text
import host "console" as console
# The demo Host registers text.ToUpper as Concurrent ReadOnly.
# A wrapper preserves that operation summary; generic Unknown contracts stay Unknown.
fn upper_request(name:string)->effect { effect text.ToUpper(name) }
flow Main() -> list {
    facts = claim()
    for name in ["ada", "lin", "sam"] parallel {
        upper = perform upper_request(name)
        facts <+ upper
    }
    results = [row.value for row in facts]
    for name in results {
        # console.write is Write and writes to stderr; calls follow source/iteration order.
        perform effect console.write("processed " + name)
    }
    return results
}
