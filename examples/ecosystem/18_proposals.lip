# Run: lipc run -host demo examples/ecosystem/18_proposals.lip
# A proposal is a value; constructing or binding it does not call the provider.
# perform is the only execution boundary; ordinary fn cannot perform.
import go "strings" as text
import python "statistics" as stats
# Pure construction retains the returned operation; it does not call Go.
fn upper_request(value:string)->effect { effect text.ToUpper(value) }
# Ordinary fn parameters/results can carry requests. An unknown operation
# parameter remains conservative for parallel safety; a known request argument
# can now be substituted into the summary at the call site.
fn forward(request:effect)->effect { request }
# Same-run Flows can return a request or receive one for execution. This is
# value transport: Execute receives the request and its review decision.
flow Prepare(value:string)->effect { return upper_request(value) }
flow Execute(request:effect)->any {
    # Execute is called only after Main has reviewed str(request).
    return perform request
}
flow Main() -> object {
    # Construction is pure; it does not call Go.
    request = Prepare("hello")
    # print(request) emits searchable path:value lines for every review field.
    print(request)
    # This condition is the coder's review decision. A changed operation,
    # argument or contract must be reviewed again before this is set true.
    coder_approved = true
    result = if coder_approved { Execute(request) } else { null }
    # A recorded external result can become an argument to the next request.
    repeated_request = forward(upper_request(result + ", lip"))
    print(repeated_request)
    repeated_approved = true
    repeated = if repeated_approved { perform repeated_request } else { null }
    # The operation's result schema decides the type: string above, number here.
    average_request = effect stats.mean([1, 2, 3])
    print(average_request)
    average_approved = true
    average = if average_approved { perform average_request } else { null }
    # The effect is consumed and never serialized; only Data leaves the Flow.
    return {first: result, second: repeated, average: average}
}
