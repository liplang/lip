# Prototype 24: a scientific DAG with two independent preprocessing/model
# branches. The actual numerical work belongs in Go Host adapters.
import host "load_data"
import host "preprocess_left"
import host "preprocess_right"
import host "model_one"
import host "model_two"
import host "combine"
flow ScienceDAG(path: string) -> any {
    data = load_data(path)
    left = preprocess_left(data)
    right = preprocess_right(data)
    model_left = model_one(left)
    model_right = model_two(right)
    return combine(model_left, model_right)
}
