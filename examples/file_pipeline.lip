// Prototype 22: parse -> validate -> transform -> save.
import host "read_file"
import host "parse_document"
import host "validate_document"
import host "transform_document"
import host "save_document"
flow FilePipeline(path: string) -> any? {
    raw = read_file(path)
    document = parse_document(raw)
    valid = validate_document(document)
    when valid {
        transformed = transform_document(document)
        return save_document(transformed)
    }
}
