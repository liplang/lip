# Independent conclusions contribute evidence; a complete snapshot produces the missing-evidence report.
# Without live snapshots, the collected result is independent of legal schedule order.
flow Evidence() -> object {
    facts = claim()
    for conclusion in ["a", "b", "c"] parallel {
        facts <+ {name: conclusion, evidence: if conclusion == "a" {["source"]} else {[]}}
    }
    rows = facts
    missing = [row.value.name for row in rows if len(row.value.evidence) == 0]
    return {missing: missing}
}
