# An ordinary for executes statements per item; bindings do not carry between iterations.
# continue skips the rest of an iteration; break ends the nearest ordinary loop.
# Declare Claims only at Flow top level; <+ appends facts without overwriting records.
flow Main() -> list {
    facts = claim()
    for x in [1, 2, 3, 4, 5] {
        if x == 2 { continue }
        if x == 4 { break }
        facts <+ x
    }
    # Reading facts waits for all selected writers and returns a complete snapshot.
    # Records contain value, run_id, position, and id; here we project only business values.
    return [row.value for row in facts]
}
