# if has statement and expression forms.
# Use an expression to bind a conditional result; each branch ends with its value.
# Branch-local names do not escape their branch.
flow Conditions() -> object {
    score = 0.85
    grade = if score >= 0.8 {
        label = "ready"
        label
    } else { "needs work" }
    # && / || short-circuit. The division by zero on the right is never evaluated.
    safe = false && (1 / 0 == 1)
    return {grade: grade, safe: safe}
}
