# map 依次转换有限列表，fold 按列表顺序携带一个累积值。
# 回调必须是 LIP 纯函数；外部调用使用 carry，而非 effectful callback。
fn add(a: number, b: number) -> number { a + b }
flow ListCalculation() -> object {
    squares = map([1, 2, 3, 4], fn(x: number) -> number { x * x })
    total = fold(squares, 0, add)
    return {squares: squares, total: total}
}
