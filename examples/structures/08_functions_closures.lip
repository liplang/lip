# fn is pure: it cannot perform or capture a live Claim store.
# The final expression gives the fn result; an explicit final return is also allowed.
# Functions are values: pass, return, and capture immutable values.
fn make_adder(offset: number) -> function {
    fn(x: number) -> number { x + offset }
}
fn multiply(a: number, b: number) -> number { a * b }
flow Main() -> object {
    add_ten = make_adder(10)
    # User functions accept named arguments after all positional arguments.
    return {mapped: map([1, 2, 3], add_ten), product: multiply(4, b=5)}
}
