# match tries arms in order; patterns go before => and results after it.
# Patterns are literals, type names, or _. The wildcard _ matches any value.
# An optional if guard runs after matching; has protects access to missing fields.
fn describe(x: any) -> string {
    match x {
        null => "empty",
        number if x >= 0 => "nonnegative",
        object if has(x, "kind") && x.kind == "note" => "note",
        _ => "other"
    }
}
flow Matching() -> list {
    return map([null, 3, -2, {kind: "note"}, {}], describe)
}
