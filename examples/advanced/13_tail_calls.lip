# A tail call directly supplies the function result; 100,000 iterations do not grow the call stack.
# The guarantee covers direct, mutually recursive, and indirect function-value tail calls.
fn sum_to(n: number, acc: number) -> number {
    if n == 0 { acc } else { sum_to(n - 1, acc + n) }
}
fn even(n: number) -> bool { if n == 0 { true } else { odd(n - 1) } }
fn odd(n: number) -> bool { if n == 0 { false } else { even(n - 1) } }
fn indirect(n: number, callback: function) -> number {
    if n == 0 { 0 } else { callback(n - 1, callback) }
}
flow Main() -> object {
    return {sum: sum_to(100000, 0), even: even(100000), indirect: indirect(100000, indirect)}
}
