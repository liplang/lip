# Represent recoverable business failures as Data to count, branch, or continue.
# fail("...") terminates the node with a program error; it is not a catchable business value.
# The carry stops on the third failure; later items are never processed.
flow BusinessFailures() -> object {
    stopped = for result in [
        {ok: false}, {ok: true}, {ok: false}, {ok: false}, {ok: true}
    ] with s = {failures: 0, visited: 0} {
        failures = if result.ok { s.failures } else { s.failures + 1 }
        updated = {failures: failures, visited: s.visited + 1}
        if failures == 3 { break updated }
        else { next updated }
    }
    return stopped
}
