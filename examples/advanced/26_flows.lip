# Run: lipc run -input '{"xs":[3,1,2]}' examples/advanced/26_flows.lip
# Main is the default root entry; -entry selects another. All declarations are checked.
# export enables reuse through import lip; declarations are private by default.
export OFFSET:number = 2

fn add(value:number, delta:number)->number { value + delta }

export flow Adjust(value:number)->number {
    # Evaluate the left side once and inject its result into the named stage first parameter.
    return value |> add(delta=OFFSET)
}

flow Main(xs:list)->object {
    facts = claim()
    for x in xs parallel {
        # Each iteration calls its own Adjust child graph; result is available after complete success.
        result = x |> Adjust
        # All three iterations contribute to the same facts store created by this Main invocation.
        facts <+ result
    }
    return {values:[row.value for row in facts], count:facts |> len}
}
