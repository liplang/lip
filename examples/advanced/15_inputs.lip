# Flow parameters come from the CLI JSON object; field names match parameter names.
# Run: lipc run -input '{"name":"Ada","scores":[0.6,0.9]}' examples/advanced/15_inputs.lip
# Inputs and outputs must be Data: null/bool/number/string/list/object.
flow Inputs(name: string, scores: list) -> object {
    good = [score for score in scores if score >= 0.8]
    return {message: "Hello, " + name, accepted: good}
}
