# parallel 允许各轮独立计算；不要依赖任务完成顺序。
# Claim 追加带身份的事实，完整快照按逻辑 Position 排序。
# count/latest 等业务投影是纯计算，不是共享变量更新。
flow ParallelFacts() -> object {
    facts = claim()
    for x in [3, 1, 2] parallel {
        facts <+ {input: x, square: x * x}
    }
    rows = facts
    return {count: len(rows), results: [row.value for row in rows]}
}
