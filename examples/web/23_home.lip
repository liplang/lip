# Default route: GET /{$}. Triple quotes preserve HTML indentation and newlines.
# This page is static; render dynamic user content through an automatically escaping template Host.
flow Home(request: object) -> object {
    return {
        status: 200,
        headers: {"Content-Type": "text/html; charset=utf-8"},
        body: """<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>LIP website</title>
<main><h1>Hello, LIP!</h1><p>This page is returned by a LIP Flow.</p></main>
</html>
"""
    }
}
